# ═══════════════════════════════════════════════════════════════
# Trust Work Escrow — Environment Configuration
# Copy this file to .env and customize for your environment.
# ═══════════════════════════════════════════════════════════════

# Solana cluster (mainnet-beta, devnet, testnet, localhost)
SOLANA_CLUSTER=localhost

# Custom RPC endpoint (optional, leave empty to use default for cluster)
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Anchor provider wallet (defaults to ~/.config/solana/id.json)
# ANCHOR_WALLET=~/.config/solana/id.json

# Anchor provider cluster (uses SOLANA_CLUSTER if not set)
# ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
